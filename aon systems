<style>
/* ============================================================
   AXON SYSTEMS — PRODUCTION WEBSITE
   Ultra-premium, cinematic, enterprise-grade
   ============================================================ */

*, *::before, *::after {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

:root {
  --black: #000000;
  --white: #ffffff;
  --gray-50: #f9f9f9;
  --gray-100: #f0f0f0;
  --gray-200: #e0e0e0;
  --gray-300: #c0c0c0;
  --gray-400: #a0a0a0;
  --gray-500: #808080;
  --gray-600: #606060;
  --gray-700: #404040;
  --gray-800: #222222;
  --gray-850: #161616;
  --gray-900: #0a0a0a;
  --gray-950: #050505;

  --font-display: 'DM Sans', sans-serif;
  --font-mono: 'DM Mono', monospace;

  --ease-out: cubic-bezier(0.16, 1, 0.3, 1);
  --ease-in-out: cubic-bezier(0.45, 0, 0.55, 1);
  --ease-spring: cubic-bezier(0.34, 1.56, 0.64, 1);
}

html {
  scroll-behavior: smooth;
  font-size: 16px;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

body {
  background-color: var(--black);
  color: var(--white);
  font-family: var(--font-display);
  line-height: 1.6;
  overflow-x: hidden;
  cursor: none;
}

/* ============================================================
   CUSTOM CURSOR
   ============================================================ */

.cursor {
  width: 8px;
  height: 8px;
  background: var(--white);
  border-radius: 50%;
  position: fixed;
  top: 0; left: 0;
  pointer-events: none;
  z-index: 9999;
  transform: translate(-50%, -50%);
  transition: width 0.3s var(--ease-out), height 0.3s var(--ease-out), background 0.3s ease, opacity 0.3s ease;
  mix-blend-mode: difference;
}

.cursor-follower {
  width: 36px;
  height: 36px;
  border: 1px solid rgba(255,255,255,0.3);
  border-radius: 50%;
  position: fixed;
  top: 0; left: 0;
  pointer-events: none;
  z-index: 9998;
  transform: translate(-50%, -50%);
  transition: width 0.4s var(--ease-out), height 0.4s var(--ease-out), border-color 0.3s ease;
}

body:hover .cursor { opacity: 1; }

a:hover ~ .cursor,
button:hover ~ .cursor { width: 16px; height: 16px; }

/* ============================================================
   NOISE TEXTURE OVERLAY
   ============================================================ */

.noise-overlay {
  position: fixed;
  top: 0; left: 0;
  width: 100%; height: 100%;
  pointer-events: none;
  z-index: 9990;
  opacity: 0.035;
  background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)'/%3E%3C/svg%3E");
  background-repeat: repeat;
  background-size: 256px 256px;
}

/* ============================================================
   FLOATING WHATSAPP BUTTON
   ============================================================ */

.whatsapp-float {
  position: fixed;
  bottom: 36px;
  right: 36px;
  z-index: 9000;
  display: flex;
  align-items: center;
  gap: 12px;
  cursor: none;
}

.whatsapp-float a {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 56px;
  height: 56px;
  background: var(--white);
  border-radius: 50%;
  color: var(--black);
  text-decoration: none;
  transition: transform 0.4s var(--ease-spring), box-shadow 0.4s ease;
  box-shadow: 0 8px 40px rgba(255,255,255,0.12);
  position: relative;
}

.whatsapp-float a::before {
  content: '';
  position: absolute;
  inset: -1px;
  border-radius: 50%;
  border: 1px solid rgba(255,255,255,0.2);
  animation: pulse-ring 3s ease-in-out infinite;
}

@keyframes pulse-ring {
  0%, 100% { transform: scale(1); opacity: 0.6; }
  50% { transform: scale(1.2); opacity: 0; }
}

.whatsapp-float a:hover {
  transform: scale(1.08);
  box-shadow: 0 12px 60px rgba(255,255,255,0.22);
}

.whatsapp-float a svg {
  width: 24px;
  height: 24px;
}

.whatsapp-label {
  background: var(--gray-850);
  border: 1px solid var(--gray-700);
  color: var(--gray-200);
  font-family: var(--font-display);
  font-size: 12px;
  font-weight: 400;
  letter-spacing: 0.08em;
  padding: 8px 14px;
  border-radius: 100px;
  white-space: nowrap;
  opacity: 0;
  transform: translateX(8px);
  transition: opacity 0.3s ease, transform 0.3s ease;
  pointer-events: none;
}

.whatsapp-float:hover .whatsapp-label {
  opacity: 1;
  transform: translateX(0);
}

/* ============================================================
   NAVBAR
   ============================================================ */

.navbar {
  position: fixed;
  top: 0; left: 0; right: 0;
  z-index: 8000;
  padding: 0 48px;
  height: 72px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  transition: background 0.6s ease, border-color 0.6s ease, backdrop-filter 0.6s ease;
  border-bottom: 1px solid transparent;
}

.navbar.scrolled {
  background: rgba(0,0,0,0.85);
  backdrop-filter: blur(20px) saturate(0);
  -webkit-backdrop-filter: blur(20px) saturate(0);
  border-bottom-color: rgba(255,255,255,0.06);
}

.nav-logo {
  display: flex;
  align-items: center;
  gap: 10px;
  text-decoration: none;
  color: var(--white);
}

.nav-logo-mark {
  width: 32px;
  height: 32px;
  position: relative;
}

.nav-logo-mark svg {
  width: 100%;
  height: 100%;
}

.nav-logo-text {
  font-size: 15px;
  font-weight: 500;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: var(--white);
}

.nav-links {
  display: flex;
  align-items: center;
  gap: 40px;
  list-style: none;
}

.nav-links a {
  color: var(--gray-400);
  text-decoration: none;
  font-size: 13px;
  font-weight: 400;
  letter-spacing: 0.05em;
  transition: color 0.3s ease;
  cursor: none;
}

.nav-links a:hover {
  color: var(--white);
}

.nav-actions {
  display: flex;
  align-items: center;
  gap: 20px;
}

.nav-instagram {
  color: var(--gray-500);
  text-decoration: none;
  transition: color 0.3s ease;
  cursor: none;
  display: flex;
  align-items: center;
}

.nav-instagram:hover { color: var(--white); }

.nav-instagram svg { width: 18px; height: 18px; }

.btn-nav {
  background: var(--white);
  color: var(--black);
  border: none;
  padding: 10px 22px;
  font-family: var(--font-display);
  font-size: 12px;
  font-weight: 500;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  cursor: none;
  text-decoration: none;
  transition: background 0.3s ease, transform 0.3s var(--ease-spring), box-shadow 0.3s ease;
  border-radius: 2px;
}

.btn-nav:hover {
  background: var(--gray-100);
  transform: translateY(-1px);
  box-shadow: 0 6px 24px rgba(255,255,255,0.1);
}

.hamburger {
  display: none;
  flex-direction: column;
  gap: 5px;
  cursor: none;
  background: none;
  border: none;
  padding: 4px;
}

.hamburger span {
  display: block;
  width: 24px;
  height: 1px;
  background: var(--white);
  transition: transform 0.3s ease, opacity 0.3s ease;
}

/* ============================================================
   HERO SECTION
   ============================================================ */

.hero {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  justify-content: center;
  position: relative;
  overflow: hidden;
  padding: 120px 48px 80px;
}

/* Animated Grid Background */
.hero-grid {
  position: absolute;
  inset: 0;
  background-image:
    linear-gradient(rgba(255,255,255,0.025) 1px, transparent 1px),
    linear-gradient(90deg, rgba(255,255,255,0.025) 1px, transparent 1px);
  background-size: 80px 80px;
  animation: grid-drift 20s linear infinite;
  mask-image: radial-gradient(ellipse 80% 60% at 50% 50%, black 30%, transparent 100%);
  -webkit-mask-image: radial-gradient(ellipse 80% 60% at 50% 50%, black 30%, transparent 100%);
}

@keyframes grid-drift {
  0% { transform: translateY(0); }
  100% { transform: translateY(80px); }
}

/* Abstract Geometric Elements */
.hero-geo {
  position: absolute;
  right: -120px;
  top: 50%;
  transform: translateY(-50%);
  width: 700px;
  height: 700px;
  opacity: 0.06;
}

.hero-geo-inner {
  position: absolute;
  inset: 0;
  border-radius: 50%;
  border: 1px solid rgba(255,255,255,0.8);
  animation: rotate-slow 40s linear infinite;
}

.hero-geo-inner:nth-child(2) {
  inset: 60px;
  border-radius: 20%;
  border-color: rgba(255,255,255,0.6);
  animation-direction: reverse;
  animation-duration: 28s;
}

.hero-geo-inner:nth-child(3) {
  inset: 140px;
  border-radius: 50%;
  border-color: rgba(255,255,255,0.4);
  animation-duration: 18s;
}

.hero-geo-inner:nth-child(4) {
  inset: 200px;
  border-radius: 10%;
  border-color: rgba(255,255,255,0.3);
  animation-direction: reverse;
  animation-duration: 12s;
}

@keyframes rotate-slow {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

/* Floating Dashboard Preview */
.hero-dashboard {
  position: absolute;
  right: 6%;
  top: 50%;
  transform: translateY(-44%);
  width: 440px;
  opacity: 0;
  animation: fade-float-in 1.2s var(--ease-out) 1.2s forwards;
}

@keyframes fade-float-in {
  from { opacity: 0; transform: translateY(-40%) translateX(40px); }
  to { opacity: 1; transform: translateY(-44%) translateX(0); }
}

.dashboard-card {
  background: rgba(255,255,255,0.03);
  border: 1px solid rgba(255,255,255,0.08);
  border-radius: 12px;
  padding: 24px;
  backdrop-filter: blur(12px);
  position: relative;
  overflow: hidden;
}

.dashboard-card::before {
  content: '';
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 1px;
  background: linear-gradient(90deg, transparent, rgba(255,255,255,0.15), transparent);
}

.dashboard-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20px;
}

.dashboard-title {
  font-size: 11px;
  font-weight: 500;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--gray-400);
  font-family: var(--font-mono);
}

.dashboard-status {
  display: flex;
  align-items: center;
  gap: 6px;
  font-size: 10px;
  color: var(--gray-500);
  font-family: var(--font-mono);
}

.status-dot {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: var(--gray-300);
  animation: blink 2s ease-in-out infinite;
}

@keyframes blink {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.3; }
}

.dashboard-metric {
  margin-bottom: 16px;
}

.metric-label {
  font-size: 10px;
  font-family: var(--font-mono);
  color: var(--gray-600);
  letter-spacing: 0.1em;
  text-transform: uppercase;
  margin-bottom: 4px;
}

.metric-value {
  font-size: 28px;
  font-weight: 300;
  color: var(--white);
  letter-spacing: -0.02em;
  line-height: 1;
}

.metric-change {
  font-size: 10px;
  font-family: var(--font-mono);
  color: var(--gray-400);
  margin-top: 4px;
}

.dashboard-chart {
  height: 60px;
  display: flex;
  align-items: flex-end;
  gap: 3px;
  margin-top: 16px;
}

.chart-bar {
  flex: 1;
  background: rgba(255,255,255,0.08);
  border-radius: 2px 2px 0 0;
  position: relative;
  overflow: hidden;
}

.chart-bar::after {
  content: '';
  position: absolute;
  bottom: 0; left: 0; right: 0;
  background: rgba(255,255,255,0.25);
  border-radius: 2px 2px 0 0;
  animation: bar-grow 1.5s var(--ease-out) 2s both;
}

.chart-bar:nth-child(1)::after { height: 35%; animation-delay: 1.5s; }
.chart-bar:nth-child(2)::after { height: 55%; animation-delay: 1.6s; }
.chart-bar:nth-child(3)::after { height: 40%; animation-delay: 1.7s; }
.chart-bar:nth-child(4)::after { height: 70%; animation-delay: 1.8s; }
.chart-bar:nth-child(5)::after { height: 60%; animation-delay: 1.9s; }
.chart-bar:nth-child(6)::after { height: 85%; animation-delay: 2.0s; }
.chart-bar:nth-child(7)::after { height: 75%; animation-delay: 2.1s; }
.chart-bar:nth-child(8)::after { height: 90%; animation-delay: 2.2s; }

@keyframes bar-grow {
  from { transform: scaleY(0); transform-origin: bottom; }
  to { transform: scaleY(1); transform-origin: bottom; }
}

/* Floating mini cards */
.hero-mini-card {
  position: absolute;
  background: rgba(255,255,255,0.04);
  border: 1px solid rgba(255,255,255,0.08);
  border-radius: 8px;
  padding: 12px 16px;
  font-family: var(--font-mono);
  font-size: 10px;
  color: var(--gray-400);
  letter-spacing: 0.08em;
  animation: float-ambient 6s ease-in-out infinite;
}

.hero-mini-card-1 {
  top: 20%;
  right: 5%;
  animation-delay: 0s;
}

.hero-mini-card-2 {
  bottom: 28%;
  right: 8%;
  animation-delay: 2s;
}

@keyframes float-ambient {
  0%, 100% { transform: translateY(0px); }
  50% { transform: translateY(-10px); }
}

.mini-card-label {
  color: var(--gray-600);
  font-size: 9px;
  text-transform: uppercase;
  letter-spacing: 0.12em;
  margin-bottom: 6px;
}

.mini-card-value {
  color: var(--white);
  font-size: 16px;
  font-weight: 400;
  letter-spacing: -0.02em;
}

/* Hero Content */
.hero-content {
  position: relative;
  z-index: 10;
  max-width: 760px;
}

.hero-eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  font-family: var(--font-mono);
  font-size: 11px;
  font-weight: 400;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  color: var(--gray-500);
  margin-bottom: 40px;
  opacity: 0;
  transform: translateY(16px);
  animation: fade-up 0.8s var(--ease-out) 0.3s forwards;
}

.hero-eyebrow::before {
  content: '';
  display: block;
  width: 24px;
  height: 1px;
  background: var(--gray-600);
}

.hero-headline {
  font-size: clamp(52px, 7vw, 96px);
  font-weight: 200;
  line-height: 1.0;
  letter-spacing: -0.03em;
  color: var(--white);
  margin-bottom: 32px;
}

.hero-headline .line {
  display: block;
  overflow: hidden;
}

.hero-headline .line span {
  display: block;
  opacity: 0;
  transform: translateY(100%);
  animation: line-reveal 0.9s var(--ease-out) forwards;
}

.hero-headline .line:nth-child(1) span { animation-delay: 0.5s; }
.hero-headline .line:nth-child(2) span { animation-delay: 0.65s; }
.hero-headline .line:nth-child(3) span { animation-delay: 0.8s; font-style: italic; color: var(--gray-400); font-weight: 200; }

@keyframes line-reveal {
  to { opacity: 1; transform: translateY(0); }
}

.hero-sub {
  font-size: clamp(15px, 1.6vw, 18px);
  font-weight: 300;
  line-height: 1.7;
  color: var(--gray-500);
  max-width: 520px;
  margin-bottom: 52px;
  opacity: 0;
  animation: fade-up 0.8s var(--ease-out) 1.0s forwards;
}

.hero-actions {
  display: flex;
  align-items: center;
  gap: 20px;
  flex-wrap: wrap;
  opacity: 0;
  animation: fade-up 0.8s var(--ease-out) 1.1s forwards;
}

@keyframes fade-up {
  to { opacity: 1; transform: translateY(0); }
}

.btn-primary {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  background: var(--white);
  color: var(--black);
  text-decoration: none;
  padding: 16px 32px;
  font-family: var(--font-display);
  font-size: 13px;
  font-weight: 500;
  letter-spacing: 0.06em;
  cursor: none;
  border-radius: 2px;
  transition: background 0.3s ease, transform 0.4s var(--ease-spring), box-shadow 0.4s ease;
  border: none;
}

.btn-primary:hover {
  background: var(--gray-100);
  transform: translateY(-2px);
  box-shadow: 0 16px 48px rgba(255,255,255,0.15);
}

.btn-secondary {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  background: transparent;
  color: var(--gray-400);
  text-decoration: none;
  padding: 16px 24px;
  font-family: var(--font-display);
  font-size: 13px;
  font-weight: 400;
  letter-spacing: 0.06em;
  cursor: none;
  border: 1px solid rgba(255,255,255,0.1);
  border-radius: 2px;
  transition: color 0.3s ease, border-color 0.3s ease, transform 0.4s var(--ease-spring);
}

.btn-secondary:hover {
  color: var(--white);
  border-color: rgba(255,255,255,0.3);
  transform: translateY(-2px);
}

/* Scroll Indicator */
.scroll-indicator {
  position: absolute;
  bottom: 40px;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8px;
  opacity: 0;
  animation: fade-up 0.8s var(--ease-out) 1.6s forwards;
}

.scroll-line {
  width: 1px;
  height: 48px;
  background: linear-gradient(to bottom, transparent, rgba(255,255,255,0.3));
  position: relative;
  overflow: hidden;
}

.scroll-line::after {
  content: '';
  position: absolute;
  top: -100%;
  left: 0;
  width: 100%;
  height: 100%;
  background: var(--white);
  animation: scroll-down 2.5s ease-in-out infinite;
}

@keyframes scroll-down {
  0% { top: -100%; }
  50% { top: 100%; }
  51%, 100% { top: -100%; }
}

.scroll-text {
  font-family: var(--font-mono);
  font-size: 9px;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: var(--gray-600);
  writing-mode: vertical-rl;
  transform: rotate(180deg);
}

/* ============================================================
   SECTION UTILITIES
   ============================================================ */

section {
  position: relative;
}

.container {
  max-width: 1280px;
  margin: 0 auto;
  padding: 0 48px;
}

.section-eyebrow {
  font-family: var(--font-mono);
  font-size: 10px;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: var(--gray-600);
  margin-bottom: 24px;
  display: flex;
  align-items: center;
  gap: 12px;
}

.section-eyebrow::before {
  content: '';
  display: block;
  width: 20px;
  height: 1px;
  background: var(--gray-700);
}

.section-divider {
  width: 100%;
  height: 1px;
  background: rgba(255,255,255,0.05);
}

/* Reveal animations */
.reveal {
  opacity: 0;
  transform: translateY(32px);
  transition: opacity 0.9s var(--ease-out), transform 0.9s var(--ease-out);
}

.reveal.visible {
  opacity: 1;
  transform: translateY(0);
}

.reveal-delay-1 { transition-delay: 0.1s; }
.reveal-delay-2 { transition-delay: 0.2s; }
.reveal-delay-3 { transition-delay: 0.3s; }
.reveal-delay-4 { transition-delay: 0.4s; }
.reveal-delay-5 { transition-delay: 0.5s; }
.reveal-delay-6 { transition-delay: 0.6s; }

/* ============================================================
   POSITIONING SECTION
   ============================================================ */

.positioning {
  padding: 160px 0;
  background: var(--black);
}

.positioning-inner {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 120px;
  align-items: start;
}

.positioning-left {
  position: sticky;
  top: 120px;
}

.positioning-title {
  font-size: clamp(36px, 4vw, 56px);
  font-weight: 200;
  line-height: 1.1;
  letter-spacing: -0.03em;
  color: var(--white);
  margin-bottom: 32px;
}

.positioning-title em {
  font-style: italic;
  color: var(--gray-500);
}

.positioning-body {
  font-size: 16px;
  font-weight: 300;
  line-height: 1.8;
  color: var(--gray-500);
  max-width: 400px;
}

.positioning-right {
  display: flex;
  flex-direction: column;
  gap: 0;
}

.problem-item {
  padding: 32px 0;
  border-bottom: 1px solid rgba(255,255,255,0.05);
  display: flex;
  gap: 24px;
  align-items: flex-start;
