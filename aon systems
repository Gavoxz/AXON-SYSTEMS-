/* Node Flow */
.node-flow {
  position: relative;
  height: 480px;
  background: rgba(255,255,255,0.015);
  border: 1px solid rgba(255,255,255,0.05);
  border-radius: 16px;
  overflow: hidden;
  padding: 32px;
}

.node-flow-bg {
  position: absolute;
  inset: 0;
  background-image:
    linear-gradient(rgba(255,255,255,0.02) 1px, transparent 1px),
    linear-gradient(90deg, rgba(255,255,255,0.02) 1px, transparent 1px);
  background-size: 40px 40px;
}

.flow-node {
  position: absolute;
  background: rgba(255,255,255,0.04);
  border: 1px solid rgba(255,255,255,0.1);
  border-radius: 8px;
  padding: 12px 16px;
  font-family: var(--font-mono);
  font-size: 10px;
  color: var(--gray-400);
  letter-spacing: 0.08em;
  white-space: nowrap;
  cursor: none;
  transition: background 0.3s ease, border-color 0.3s ease, transform 0.3s var(--ease-spring);
  z-index: 10;
}

.flow-node:hover {
  background: rgba(255,255,255,0.08);
  border-color: rgba(255,255,255,0.2);
  transform: scale(1.04);
}

.flow-node.active {
  border-color: rgba(255,255,255,0.25);
  background: rgba(255,255,255,0.06);
}

.node-n1 { top: 40px; left: 50%; transform: translateX(-50%); }
.node-n2 { top: 140px; left: 30px; }
.node-n3 { top: 140px; right: 30px; }
.node-n4 { top: 250px; left: 50px; }
.node-n5 { top: 250px; right: 50px; }
.node-n6 { top: 360px; left: 50%; transform: translateX(-50%); }

.flow-connector {
  position: absolute;
  background: rgba(255,255,255,0.08);
  z-index: 5;
  border-radius: 1px;
}

.flow-connector.vertical { width: 1px; }
.flow-connector.horizontal { height: 1px; }

/* Animated flow particle */
.flow-particle {
  position: absolute;
  width: 4px;
  height: 4px;
  border-radius: 50%;
  background: rgba(255,255,255,0.6);
  z-index: 15;
  animation: flow-move 3s ease-in-out infinite;
}

@keyframes flow-move {
  0% { opacity: 0; top: 80px; left: 50%; transform: translateX(-50%); }
  20% { opacity: 1; }
  50% { opacity: 1; top: 180px; left: 30%; }
  80% { opacity: 0.5; top: 380px; left: 50%; transform: translateX(-50%); }
  100% { opacity: 0; top: 380px; left: 50%; transform: translateX(-50%); }
}

